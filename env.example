# Configuration PostgreSQL
# Copiez ce fichier en .env et remplissez les valeurs

# Base de données PostgreSQL
# Format: postgresql://user:password@host:port/database?schema=public
# Exemple Neon: postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# NextAuth Configuration
# URL de votre site (local pour dev, https://votre-site.vercel.app pour production)
NEXTAUTH_URL="http://localhost:3000"

# SEO Configuration
# URL publique de votre site (utilisée pour les métadonnées SEO, sitemap, etc.)
# En production: https://chakir.dev
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL="https://chakir.dev"

# Secret pour NextAuth (générez-en un avec: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET="changez-moi-en-production"

# Identifiants Admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

