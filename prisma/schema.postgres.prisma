// Schema Prisma pour PostgreSQL (Production sur Vercel)
// Pour utiliser ce schéma, renommez-le en schema.prisma et changez provider à "postgresql"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model ProjectSubmission {
  id                Int      @id @default(autoincrement())
  fullName           String
  email              String
  phone              String?
  company            String?
  projectType        String
  projectTitle       String
  projectDescription String
  budget             String?
  timeline           String?
  features           String?
  technologies       String?
  reference          String?
  additionalInfo     String?
  createdAt          DateTime @default(now())
}

